{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sgx:classification:v1",
  "title": "SGX classification v1 — integration contract only",
  "definitions": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "format": "date-time"
    },
    "SchemaVersion": {
      "const": "1.0"
    },
    "ClassificationFacet": {
      "type": "string",
      "enum": [
        "time",
        "place",
        "person",
        "event",
        "scene",
        "theme",
        "content_type",
        "quality",
        "duplicate"
      ]
    },
    "JobStatus": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "succeeded",
        "needs_review",
        "failed_retryable",
        "failed_terminal",
        "cancelled"
      ]
    },
    "ProviderStatus": {
      "type": "string",
      "enum": [
        "succeeded",
        "needs_review",
        "failed_retryable",
        "failed_terminal",
        "cancelled"
      ]
    },
    "AssertionState": {
      "type": "string",
      "enum": [
        "proposed",
        "confirmed",
        "edited",
        "rejected",
        "conflicted",
        "withdrawn"
      ]
    },
    "LifecycleState": {
      "type": "string",
      "enum": [
        "active",
        "trashed",
        "deletion_pending",
        "deleted"
      ]
    },
    "ProviderErrorCode": {
      "type": "string",
      "enum": [
        "TIMEOUT",
        "PROVIDER_UNAVAILABLE",
        "INVALID_OUTPUT",
        "CANCELLED",
        "UNSUPPORTED_INPUT",
        "INTERNAL_ERROR"
      ]
    },
    "SourceType": {
      "type": "string",
      "enum": [
        "visual",
        "exif",
        "ocr",
        "user_text",
        "final_asr"
      ]
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "object",
            "message"
          ]
        },
        "id": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "VersionStamp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "$ref": "#/definitions/SchemaVersion"
        },
        "algorithmVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "providerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "taxonomyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "schemaVersion",
        "algorithmVersion",
        "providerVersion",
        "modelVersion",
        "promptVersion",
        "taxonomyVersion"
      ]
    },
    "AsrMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "final": {
          "const": true
        },
        "producerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "final",
        "producerVersion"
      ]
    },
    "Dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "MinimalAuthorizedEvidenceRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "evidenceId": {
              "$ref": "#/definitions/Id"
            },
            "sourceRef": {
              "$ref": "#/definitions/SourceRef"
            },
            "sourceHash": {
              "$ref": "#/definitions/Hash"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20971520
            },
            "modality": {
              "const": "image"
            },
            "mimeType": {
              "type": "string",
              "enum": [
                "image/jpeg",
                "image/png",
                "image/webp"
              ]
            },
            "dimensions": {
              "$ref": "#/definitions/Dimensions"
            }
          },
          "required": [
            "evidenceId",
            "sourceRef",
            "sourceHash",
            "revision",
            "byteLength",
            "modality",
            "mimeType",
            "dimensions"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "evidenceId": {
              "$ref": "#/definitions/Id"
            },
            "sourceRef": {
              "$ref": "#/definitions/SourceRef"
            },
            "sourceHash": {
              "$ref": "#/definitions/Hash"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20971520
            },
            "modality": {
              "const": "text"
            },
            "mimeType": {
              "const": "text/plain"
            }
          },
          "required": [
            "evidenceId",
            "sourceRef",
            "sourceHash",
            "revision",
            "byteLength",
            "modality",
            "mimeType"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "evidenceId": {
              "$ref": "#/definitions/Id"
            },
            "sourceRef": {
              "$ref": "#/definitions/SourceRef"
            },
            "sourceHash": {
              "$ref": "#/definitions/Hash"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
