            "byteLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20971520
            },
            "modality": {
              "const": "transcript"
            },
            "mimeType": {
              "const": "text/plain"
            },
            "asr": {
              "$ref": "#/definitions/AsrMetadata"
            }
