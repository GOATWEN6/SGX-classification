{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sgx:classification-http:v1",
  "definitions": {
    "ClassificationHttpRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "requestId",
        "purpose",
        "scope",
        "authorizationRevision",
        "deadlineAt",
        "providerRequest"
      ],
      "properties": {
        "protocolVersion": {
          "const": "classification-http.v1"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "purpose": {
          "const": "classification"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subjectId",
            "householdId"
          ],
          "properties": {
            "subjectId": {
              "$ref": "urn:sgx:classification:v1#/definitions/Id"
            },
            "householdId": {
              "$ref": "urn:sgx:classification:v1#/definitions/Id"
            }
          }
        },
        "authorizationRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "authorizationState": {
          "enum": [
            "active",
            "withdrawn"
          ]
        },
        "deadlineAt": {
          "type": "string",
          "format": "date-time"
        },
        "scenario": {
          "enum": [
            "success",
            "needs_review",
            "conflicted",
            "timeout",
            "failed",
            "invalid_output",
            "partial_failure"
          ]
        },
        "providerRequest": {
          "$ref": "urn:sgx:classification:v1#/definitions/ClassificationProviderRequest"
        }
      }
    },
    "ClassificationHttpResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "requestId",
        "idempotencyKey",
        "resultStatus",
        "workflowStatus",
        "partial",
        "abstain",
        "needsReview",
        "failed",
        "result"
      ],
      "properties": {
        "protocolVersion": {
          "const": "classification-http.v1"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "idempotencyKey": {
          "$ref": "urn:sgx:classification:v1#/definitions/Hash"
        },
        "resultStatus": {
          "$ref": "urn:sgx:classification:v1#/definitions/ProviderStatus"
        },
        "workflowStatus": {
          "enum": [
            "succeeded",
            "needs_review",
            "failed",
            "cancelled"
          ]
        },
        "partial": {
          "type": "boolean"
        },
        "abstain": {
          "type": "array",
          "items": {
            "$ref": "urn:sgx:classification:v1#/definitions/Abstention"
          }
        },
        "needsReview": {
          "type": "boolean"
        },
        "failed": {
          "type": "boolean"
        },
        "errorCode": {
          "$ref": "urn:sgx:classification:v1#/definitions/ProviderErrorCode"
        },
        "result": {
          "$ref": "urn:sgx:classification:v1#/definitions/ClassificationProviderResult"
        }
      }
    },
    "ClassificationHttpError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "enum": [
                "NOT_FOUND",
                "UNSUPPORTED_MEDIA_TYPE",
                "BODY_TOO_LARGE",
                "INVALID_ENVELOPE",
                "INVALID_CONTRACT",
                "NOT_AUTHORIZED",
                "SCOPE_MISMATCH",
                "SCOPE_OR_DEADLINE_MISMATCH",
                "AUTHORIZATION_REVOKED",
                "AUTHORIZATION_CHANGED",
                "VERSION_EXPIRED",
                "STALE_RESULT",
                "INACTIVE_EVIDENCE",
                "IDEMPOTENCY_CONFLICT",
                "RATE_LIMITED",
                "INVALID_OUTPUT",
                "INTERNAL_ERROR"
              ]
            }
          }
        }
      }
    }
  },
  "$comment": "Loopback Fake HTTP integration draft; not a production authentication contract.",
  "allOf": [
    {
      "$ref": "#/definitions/ClassificationHttpRequest"
    }
  ]
}
