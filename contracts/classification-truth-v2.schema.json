{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sgx.local/contracts/classification-truth-v2.schema.json",
  "title": "SGX classification semantic truth v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "truthId",
    "createdAt",
    "dataset",
    "taxonomyVersion",
    "scoringPolicy",
    "blindReview",
    "items"
  ],
  "properties": {
    "schemaVersion": { "const": "sgx-truth.2" },
    "truthId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "datasetRevision", "checksumManifestSha256", "claimBoundary"],
      "properties": {
        "datasetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "datasetRevision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "checksumManifestSha256": { "$ref": "#/definitions/sha256" },
        "claimBoundary": { "const": "synthetic_functional_only" }
      }
    },
    "taxonomyVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "scoringPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "sha256"],
      "properties": {
        "policyId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "blindReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewerIds", "reviewedAt", "method", "ledgerPath", "ledgerSha256", "packetSha256", "reviewRulesSha256", "excludedArtifactTypes", "independenceBoundary"],
      "properties": {
        "reviewerIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "method": { "const": "procedural_output_blind_input_only" },
        "ledgerPath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "ledgerSha256": { "$ref": "#/definitions/sha256" },
        "packetSha256": { "$ref": "#/definitions/sha256" },
        "reviewRulesSha256": { "$ref": "#/definitions/sha256" },
        "excludedArtifactTypes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": ["model_output", "provider_response", "model_report", "previous_truth"]
          }
        },
        "independenceBoundary": {
          "const": "fresh_reviewer_for_synthetic_functional_truth_not_external_human_acceptance"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/truthItem" }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,192}$"
    },
    "facet": {
      "enum": [
        "person_identity",
        "person_cluster",
        "relationship",
        "time",
        "place",
        "event",
        "scene",
        "theme",
        "quality",
        "sensitive_fact",
        "memory_fact"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertionId", "facet", "value", "aliases", "sourceRefs", "authority", "rationale"],
      "properties": {
        "assertionId": { "$ref": "#/definitions/id" },
        "facet": { "$ref": "#/definitions/facet" },
        "value": { "type": "string", "minLength": 1, "maxLength": 256 },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "sourceRefs": { "$ref": "#/definitions/sourceRefs" },
        "targetAssetIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "authority": {
          "enum": [
            "user_explicit",
            "final_asr",
            "visual_direct",
            "trusted_original_exif",
            "ocr_candidate",
            "system_metadata"
          ]
        },
        "timeRole": { "enum": ["event", "capture", "scan", "upload"] },
        "precision": { "$ref": "#/definitions/timePrecision" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "allOf": [
        {
          "if": { "properties": { "facet": { "const": "time" } } },
          "then": { "required": ["timeRole", "precision"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["timeRole"] },
                { "required": ["precision"] }
              ]
            }
          }
        }
      ]
    },
    "acceptableVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variantId", "satisfiesAssertionId", "facet", "values", "rationale"],
      "properties": {
        "variantId": { "$ref": "#/definitions/id" },
        "satisfiesAssertionId": { "$ref": "#/definitions/id" },
        "facet": { "$ref": "#/definitions/facet" },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "timeRole": { "enum": ["event", "capture", "scan", "upload"] },
        "precision": { "$ref": "#/definitions/timePrecision" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "allOf": [
        {
          "if": { "properties": { "facet": { "const": "time" } } },
          "then": { "required": ["timeRole", "precision"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["timeRole"] },
                { "required": ["precision"] }
              ]
            }
          }
        }
      ]
    },
    "forbiddenAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertionId", "facet", "displayValue", "match", "riskClass", "rationale"],
      "properties": {
        "assertionId": { "$ref": "#/definitions/id" },
        "facet": { "$ref": "#/definitions/facet" },
        "displayValue": { "type": "string", "minLength": 1, "maxLength": 256 },
        "match": { "$ref": "#/definitions/forbiddenMatch" },
        "riskClass": { "enum": ["unsupported_extra", "unsafe_false_positive"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "allOf": [
        {
          "if": { "properties": { "facet": { "const": "time" } } },
          "then": {
            "properties": {
              "match": {
                "allOf": [
                  { "$ref": "#/definitions/forbiddenMatch" },
                  {
                    "if": { "properties": { "kind": { "const": "exact_value" } } },
                    "then": { "required": ["timeRole", "precision"] }
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "match": {
                "allOf": [
                  { "$ref": "#/definitions/forbiddenMatch" },
                  {
                    "not": {
                      "anyOf": [
                        { "required": ["timeRole"] },
                        { "required": ["precision"] }
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "conflictCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "sourceRefs", "authority", "status"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sourceRefs": { "$ref": "#/definitions/sourceRefs" },
        "authority": {
          "enum": [
            "user_explicit",
            "final_asr",
            "visual_direct",
            "trusted_original_exif",
            "ocr_candidate",
            "system_metadata"
          ]
        },
        "timeRole": { "enum": ["event", "capture", "scan", "upload"] },
        "precision": { "$ref": "#/definitions/timePrecision" },
        "status": { "enum": ["asserted", "retracted", "tentative"] }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflictId", "facet", "candidates", "resolution", "rationale"],
      "properties": {
        "conflictId": { "$ref": "#/definitions/id" },
        "facet": { "$ref": "#/definitions/facet" },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/conflictCandidate" }
        },
        "resolution": { "enum": ["unresolved", "user_corrected", "negated"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "allOf": [
        {
          "if": { "properties": { "facet": { "const": "time" } } },
          "then": {
            "properties": {
              "candidates": {
                "items": {
                  "allOf": [
                    { "$ref": "#/definitions/conflictCandidate" },
                    { "required": ["timeRole", "precision"] }
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "candidates": {
                "items": {
                  "allOf": [
                    { "$ref": "#/definitions/conflictCandidate" },
                    {
                      "not": {
                        "anyOf": [
                          { "required": ["timeRole"] },
                          { "required": ["precision"] }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "resolution": { "const": "unresolved" } },
            "required": ["resolution"]
          },
          "then": {
            "properties": {
              "candidates": {
                "items": {
                  "allOf": [
                    { "$ref": "#/definitions/conflictCandidate" },
                    { "properties": { "status": { "enum": ["asserted", "tentative"] } } }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "resolution": { "const": "user_corrected" } },
            "required": ["resolution"]
          },
          "then": {
            "properties": {
              "candidates": {
                "allOf": [
                  {
                    "items": {
                      "allOf": [
                        { "$ref": "#/definitions/conflictCandidate" },
                        { "properties": { "status": { "enum": ["asserted", "retracted"] } } }
                      ]
                    }
                  },
                  {
                    "contains": {
                      "properties": { "status": { "const": "asserted" } },
                      "required": ["status"]
                    }
                  },
                  {
                    "contains": {
                      "properties": { "status": { "const": "retracted" } },
                      "required": ["status"]
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "resolution": { "const": "negated" } },
            "required": ["resolution"]
          },
          "then": {
            "properties": {
              "candidates": {
                "items": {
                  "allOf": [
                    { "$ref": "#/definitions/conflictCandidate" },
                    { "properties": { "status": { "const": "retracted" } } }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "truthItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "sourceInputRef",
        "decisionStatus",
        "evaluation",
        "requiredCore",
        "acceptableVariants",
        "supportedExtras",
        "observations",
        "forbiddenAssertions",
        "conflicts",
        "unknownFacets",
        "expectedWorkflowStatus",
        "reviewNotes"
      ],
      "properties": {
        "itemId": { "$ref": "#/definitions/id" },
        "sourceInputRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
            "sha256": { "$ref": "#/definitions/sha256" }
          }
        },
        "decisionStatus": { "enum": ["decided", "needs_second_review"] },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["closedFacets", "excludedFacets"],
          "properties": {
            "closedFacets": {
              "const": ["time", "place", "event", "scene"]
            },
            "excludedFacets": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["facet", "reason"],
                "properties": {
                  "facet": { "enum": ["person_cluster", "theme", "quality"] },
                  "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
                }
              }
            }
          }
        },
        "requiredCore": {
          "type": "array",
          "items": { "$ref": "#/definitions/assertion" }
        },
        "acceptableVariants": {
          "type": "array",
          "items": { "$ref": "#/definitions/acceptableVariant" }
        },
        "supportedExtras": {
          "type": "array",
          "items": { "$ref": "#/definitions/assertion" }
        },
        "observations": {
          "type": "array",
          "items": { "$ref": "#/definitions/observation" }
        },
        "forbiddenAssertions": {
          "type": "array",
          "items": { "$ref": "#/definitions/forbiddenAssertion" }
        },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/definitions/conflict" }
        },
        "unknownFacets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/facet" }
        },
        "expectedWorkflowStatus": { "enum": ["succeeded", "needs_review", "not_run"] },
        "reviewNotes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationId",
        "facet",
        "kind",
        "rawValue",
        "normalizedValue",
        "role",
        "precision",
        "sourceRefs",
        "handling"
      ],
      "properties": {
        "observationId": { "$ref": "#/definitions/id" },
        "facet": { "const": "time" },
        "kind": { "const": "visible_time_text" },
        "rawValue": { "type": "string", "minLength": 1, "maxLength": 256 },
        "normalizedValue": { "type": "string", "minLength": 1, "maxLength": 256 },
        "role": { "const": "role_unknown" },
        "precision": { "enum": ["exact_day", "year_month", "year", "season", "decade", "relative"] },
        "sourceRefs": { "$ref": "#/definitions/sourceRefs" },
        "handling": { "const": "preserve_and_request_role_clarification" }
      }
    },
    "timePrecision": {
      "enum": ["exact_day", "year_month", "year", "season", "decade", "relative"]
    },
    "forbiddenMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["exact_value", "any_unmatched_in_facet", "unexpected_conflict"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 256 },
        "timeRole": { "enum": ["event", "capture", "scan", "upload"] },
        "precision": { "$ref": "#/definitions/timePrecision" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "exact_value" } } },
          "then": { "required": ["value"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["value"] },
                { "required": ["timeRole"] },
                { "required": ["precision"] }
              ]
            }
          }
        }
      ]
    }
  }
}
