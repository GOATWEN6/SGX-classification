# Environment identity
SGX_ENV=t1
SGX_WORKER_ID=virtai-worker-01
SGX_LOG_LEVEL=info

# Product control plane
SGX_CONTROL_PLANE_BASE_URL=https://replace-with-product-backend.example
SGX_POLL_INTERVAL_MS=2000
SGX_LEASE_TTL_MS=30000
SGX_MAX_CONCURRENCY=2

# Local feature service
SGX_JOB_TMP_ROOT=/tmp/sgx-classification
SGX_FEATURE_ENDPOINT=http://127.0.0.1:8765
SGX_METRICS_HOST=127.0.0.1
SGX_METRICS_PORT=9091

# Frozen component identities; replace candidates after benchmark
SGX_OCR_MODEL_ID=rapidocr/PP-OCRv5-ch-mobile
SGX_OCR_MODEL_REVISION=candidate-unbenchmarked
SGX_IMAGE_EMBEDDING_MODEL_ID=google/siglip2-base-patch16-224
SGX_TEXT_EMBEDDING_MODEL_ID=google/siglip2-base-patch16-224
SGX_EMBEDDING_REVISION=0ad8c6e0ff16615356a08a1ad8c8bbc8930c434e
SGX_EMBEDDING_DIM=768
SGX_EMBEDDING_MODE=shadow

# VLM and algorithm versions
SGX_VLM_PROVIDER=qwen
SGX_VLM_MODEL=qwen3.7-flash-2026-07-15
SGX_PROMPT_VERSION=sgx-five-facets.13
SGX_TAXONOMY_VERSION=sgx-taxonomy.1
SGX_MAX_IMAGES_PER_JOB=30
SGX_MAX_CANDIDATES_PER_CONTENT=5
SGX_PERSON_MATCHING_ENABLED=false
SGX_VLM_MAX_CONCURRENCY=2
SGX_VLM_AUTO_RETRIES=0
