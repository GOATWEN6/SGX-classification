{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sgx.example/schemas/classification-worker-provenance.v1.json",
  "title": "SGX classification worker package and model provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "freezeState",
    "releaseId",
    "createdAt",
    "environment",
    "runtimePackages",
    "models"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sgx-classification-provenance.1"
    },
    "freezeState": {
      "enum": ["example_not_deployable", "candidate", "verified"]
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "python", "gpuDevice", "gpuIndex"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 },
        "gpuDevice": { "type": "string", "minLength": 1 },
        "gpuIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "runtimePackages": {
      "type": "array",
      "items": { "$ref": "#/definitions/runtimePackage" }
    },
    "models": {
      "type": "array",
      "items": { "$ref": "#/definitions/modelArtifact" }
    }
  },
  "definitions": {
    "sha256OrPending": {
      "oneOf": [
        { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "legalReviewState": {
      "enum": [
        "pending",
        "repository_license_reviewed",
        "source_metadata_reviewed_artifact_pending",
        "artifact_reviewed"
      ]
    },
    "runtimePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sourceUrl", "artifactSha256", "runtimeLicense"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "artifactSha256": { "$ref": "#/definitions/sha256OrPending" },
        "runtimeLicense": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "spdxId", "licenseUrl", "copyrightNotice", "verificationState"],
          "properties": {
            "scope": { "const": "runtime_code_only" },
            "spdxId": { "type": ["string", "null"] },
            "licenseUrl": { "type": ["string", "null"], "format": "uri" },
            "copyrightNotice": { "type": ["string", "null"] },
            "verificationState": { "$ref": "#/definitions/legalReviewState" }
          }
        }
      }
    },
    "artifactFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256", "sizeBytes"],
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "modelArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "modelId",
        "revision",
        "sourceUrl",
        "transportState",
        "artifacts",
        "modelCopyright",
        "modelLicense",
        "runtimePackageRefs",
        "preprocessing"
      ],
      "properties": {
        "capability": { "enum": ["ocr", "image_text_embedding", "text_embedding"] },
        "modelId": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "transportState": {
          "enum": ["pending_transport", "acquired_unverified", "verified_offline"]
        },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/definitions/artifactFile" }
        },
        "modelCopyright": {
          "type": "object",
          "additionalProperties": false,
          "required": ["holder", "noticeUrl", "verificationState"],
          "properties": {
            "holder": { "type": ["string", "null"] },
            "noticeUrl": { "type": ["string", "null"], "format": "uri" },
            "verificationState": { "$ref": "#/definitions/legalReviewState" }
          }
        },
        "modelLicense": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdxId", "licenseUrl", "verificationState", "commercialUseReview"],
          "properties": {
            "spdxId": { "type": ["string", "null"] },
            "licenseUrl": { "type": ["string", "null"], "format": "uri" },
            "verificationState": { "$ref": "#/definitions/legalReviewState" },
            "commercialUseReview": { "enum": ["pending", "allowed", "restricted", "not_allowed"] }
          }
        },
        "runtimePackageRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "preprocessing": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        },
        "dimensions": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}
